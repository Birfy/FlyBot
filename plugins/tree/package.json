{
  "name": "@flybot/tree",
  "version": "0.1.0",
  "description": "FlyBot tree: recursive bot hierarchy (parent field, level-by-level delegation, create_child_bot) on top of ds-bot's flybot plugin API v1 (ctx.flybot)",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "ds-bot",
    "flybot"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/",
    "limits.json",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --import ./test/resolve.mjs --test \"test/*.test.js\""
  },
  "peerDependencies": {
    "ds-bot": ">=0.1.5-flybot.1"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
