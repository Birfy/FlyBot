@@ -0,0 +1,34 @@
+// forestOf(bots): the tree as nested nodes, synchronously, from bot records that carry
+// fields['flybot-tree'] (host bot.list() views, or the browser roster's bots). Same code runs in the
+// browser (client.js inlines an identical copy; a test keeps them in sync).
+//   node = { id, name, role, root, createdAt, children: node[] }
+//   - members: bots with treeRole or parent set, not retired
+//   - root: treeRole === 'root'; role text: 'Main bot · root of the tree' for the root
+//   - top level: roots first, then members whose parent is missing (orphans); siblings by createdAt
+//     (records without createdAt, e.g. host BotViews, keep their list order), then name
+//   - createdAt is the record's number, or null when absent
+export function forestOf(bots) {
+  const nodes = new Map()
+  let index = 0
+  for (const b of bots ?? []) {
+    const at = index++
+    const own = b?.fields?.['flybot-tree'] ?? {}
+    if (own.retired === true || (own.parent === undefined && own.treeRole === undefined)) continue
+    nodes.set(b.id, { id: b.id, name: b.name, role: own.treeRole === 'root' ? 'Main bot · root of the tree' : (own.treeRole ?? ''), root: own.treeRole === 'root', createdAt: typeof b.createdAt === 'number' ? b.createdAt : null, key: typeof b.createdAt === 'number' ? b.createdAt : at, parent: own.parent ?? null, children: [] })
+  }
+  const top = []
+  for (const n of nodes.values()) {
+    const p = n.parent !== null && n.parent !== n.id ? nodes.get(n.parent) : undefined
+    if (p) p.children.push(n); else top.push(n)
+  }
+  const order = (a, b) => (a.key - b.key) || String(a.name).localeCompare(String(b.name))
+  const seen = new Set()
+  const finish = n => {
+    if (seen.has(n.id)) return null // cycle guard
+    seen.add(n.id)
+    const { parent: _parent, key: _key, ...rest } = n
+    return { ...rest, children: n.children.sort(order).map(finish).filter(Boolean) }
+  }
+  top.sort((a, b) => (Number(b.root) - Number(a.root)) || order(a, b))
+  return top.map(finish).filter(Boolean)
+}
diff --git a/plugins/tree/src/limits.js b/plugins/tree/src/limits.js
new file mode 100644
index 0000000000000000000000000000000000000000..bb67ab0eb777d5cb7a03b37ccab8d4864e7d3a0a
--- /dev/null
+++ b/plugins/tree/src/limits.js
@@ -0,0 +1,24 @@
+import { readFileSync } from 'node:fs'
+
+const FILE = JSON.parse(readFileSync(new URL('../limits.json', import.meta.url), 'utf8'))
+export const DEFAULT_LIMITS = Object.freeze({ maxDepth: FILE.maxDepth ?? 5, maxChildren: FILE.maxChildren ?? 8 })
+
+/** Plugin config wins over limits.json. Depth counts the root as 1. */
+export function resolveLimits(config = {}) {
+  const pick = (v, d) => (Number.isInteger(v) && v > 0 ? v : d)
+  return { maxDepth: pick(config.maxDepth, DEFAULT_LIMITS.maxDepth), maxChildren: pick(config.maxChildren, DEFAULT_LIMITS.maxChildren) }
+}
+
+export const MAX_NAME_LENGTH = 40 // ds-bot roster truncates names to 40 characters
+
+const norm = s => String(s ?? '').trim().toLowerCase()
+
+/** Returns null when allowed, else the rejection reason. */
+export function checkCreate({ parentName, parentDepth, siblings, name, limits }) {
+  if (!String(name ?? '').trim()) return 'name required'
+  if (String(name).trim().length > MAX_NAME_LENGTH) return `name must be at most ${MAX_NAME_LENGTH} characters`
+  if (siblings.some(s => norm(s.name) === norm(name))) return `a child named "${String(name).trim()}" already exists under ${parentName}; delegate to it instead of creating a duplicate`
+  if (siblings.length >= limits.maxChildren) return `limit reached: ${parentName} already has ${siblings.length} children (maxChildren=${limits.maxChildren})`
+  if (parentDepth + 1 > limits.maxDepth) return `limit reached: a child of ${parentName} would be at depth ${parentDepth + 1} (maxDepth=${limits.maxDepth})`
+  return null
+}
diff --git a/plugins/tree/src/middleware.js b/plugins/tree/src/middleware.js
new file mode 100644
index 0000000000000000000000000000000000000000..6d79186219f51054e47362e847ab66e940230971
--- /dev/null
+++ b/plugins/tree/src/middleware.js
@@ -0,0 +1,33 @@
+// bot.send middleware for tree Bots: a tree Bot may message only its parent and direct children.
+// - Remote targets (msg.target.remote === true, else bot.isRemote(to)) are never tree members:
+//   no opinion (undefined), left to social; their fields are not read.
+// - A non-root tree Bot sending to a LOCAL Bot outside the tree is denied; the root (Chief, the
+//   user's main bot) may message any local bot.
+// - A local non-tree sender may reach only the tree root; other tree nodes are denied.
+// - Remote senders and non-tree -> non-tree traffic are not the tree's call: undefined.
+// - Control notices (role 'stopped' from stop_bot, 'report' from groups) bypass tree policy:
+//   a Main Bot / admin must be able to stop or report to any tree bot (ThinkFlowLab/FlyBot#15).
+// - Allowed edges: undefined, or allow + bypass:['social'] when config.bypassSocial === true.
+const DENY_EDGE = 'tree: a bot may message only its parent and its direct children'
+const DENY_INTO = 'tree: bots outside the tree may message only the tree root'
+export const CONTROL_ROLES = new Set(['stopped', 'report'])
+const DENY_OUTSIDE = 'tree: a tree bot may not message local bots outside the tree'
+
+export function treeSendMiddleware(tree, { bypassSocial = false, isRemote = () => false } = {}) {
+  return function treeSend(msg) {
+    const from = msg?.from
+    const to = msg?.target && msg.target.remote === false ? msg.target.id : msg?.to ?? msg?.target?.id
+    if (!from || !to) return undefined
+    if (CONTROL_ROLES.has(msg.role)) return bypassSocial ? { action: 'allow', bypass: ['social'] } : undefined
+    if (msg.target?.remote === true || isRemote(to)) return undefined
+    if (typeof from !== 'string' || isRemote(from)) return undefined
+    const { fromIn, toIn, allowed } = tree.isTreeEdge(from, to)
+    if (!fromIn) {
+      if (!toIn) return undefined // non-tree traffic: not the tree's call
+      return tree.isRoot(to) ? undefined : { action: 'deny', reason: DENY_INTO }
+    }
+    if (!toIn) return tree.isRoot(from) ? undefined : { action: 'deny', reason: DENY_OUTSIDE } // the root (Chief) may message any local bot
+    if (!allowed) return { action: 'deny', reason: DENY_EDGE }
+    return bypassSocial ? { action: 'allow', bypass: ['social'] } : undefined
+  }
+}
diff --git a/plugins/tree/src/prompt.js b/plugins/tree/src/prompt.js
new file mode 100644
index 0000000000000000000000000000000000000000..bd0c82798f9356194bc910161edaf0c98d649158
--- /dev/null
+++ b/plugins/tree/src/prompt.js
@@ -0,0 +1,44 @@
+// System prompt template. Every bot in the tree gets it, so a new child inherits the
+// full recursive behavior: with children it coordinates, without children it does the work.
+// Trace line ("Chief → Work → Dev"): only in answers a tree bot sends to its PARENT tree bot, so
+// the coordinator can see which path a result took. Never in replies to the user or to a remote
+// (friend's, Bot Social) bot; the root has no tree parent, so it never adds one.
+export const NO_TRACE = 'Never start a reply to the user, or to a remote bot (a friend\'s bot via Bot Social), with a trace line or a path like "A → B".'
+export function traceRule(trace, root) {
+  if (root) return `Do not start your replies with a trace or path line (e.g. "${trace} → <child>"). ${NO_TRACE}`
+  return `Only when you answer your parent bot in the tree, start that answer with a one-line trace of the path the request took, e.g. "${trace}". ${NO_TRACE}`
+}
+export function systemPrompt({ name, role, trace, children, root = false }) {
+  const head = root
+    ? [`Bot tree: you (${name}) are also the ROOT of a recursive bot tree of child bots. For tasks you delegate into the tree, follow these tree rules.`, `Your position: ${trace}`]
+    : [`You are ${name}, a bot in a recursive bot tree. Your role: ${role || '(general)'}`, `Your position: ${trace}`]
+  const tools = 'Tree tools: list_children() shows your current direct children (it may be newer than this prompt). create_child_bot(name, role_description) creates a child directly under you.'
+  if (!children.length) {
+    return [...head, '',
+      'You have no children: do the work yourself and answer concisely with concrete results.',
+      'Only if the task clearly splits into a separate domain you cannot cover, you may create a child with create_child_bot and delegate to it.',
+      'You may message only your parent and your direct children.', tools,
+      traceRule(trace, root)].join('\n')
+  }
+  return [...head, '',
+    'You are a COORDINATOR. Your direct children (the only bots you may delegate to; you cannot see deeper levels):',
+    ...children.map(c => `- ${c.name}: ${c.role || ''}`), '',
+    '1. Split the request into parts. Delegate a part only to a child whose stated scope fits it; generic abilities do not make a child fit another domain. Do not plan for grandchildren: each child decomposes its own part.',
+    '2. Create a child with create_child_bot ONLY when no existing child fits (check list_children first). Never create duplicates or overlapping scopes. If creation is rejected by limits, use the closest child.',
+    '3. Send each child only its own self-contained part, all in parallel, then wait.',
+    '4. Aggregate the answers into one concise answer for your parent (or the user). If only one child answered, pass its answer through unchanged.',
+    `5. ${traceRule(trace, root)}`,
+    'You may message only your parent and your direct children.', tools].join('\n')
+}
+
+// The tree's text is kept in a marked block inside the bot's systemPrompt, so text written by the
+// user or other plugins (e.g. on Chief) is never overwritten; only the block is replaced/removed.
+export const BLOCK_START = '<!-- flybot-tree:start -->'
+export const BLOCK_END = '<!-- flybot-tree:end -->'
+const BLOCK_RE = /\n*<!-- flybot-tree:start -->[\s\S]*?<!-- flybot-tree:end -->\n*/g
+export function withTreeBlock(current, block) {
+  const rest = String(current ?? '').replace(BLOCK_RE, '\n\n').trim()
+  if (!block) return rest
+  return [rest, `${BLOCK_START}\n${block}\n${BLOCK_END}`].filter(Boolean).join('\n\n')
+}
+export const hasTreeBlock = text => String(text ?? '').includes(BLOCK_START)
diff --git a/plugins/tree/src/tools.js b/plugins/tree/src/tools.js
new file mode 100644
index 0000000000000000000000000000000000000000..28996e96129927bf6b9e03d1babb85106cc770e9
--- /dev/null
+++ b/plugins/tree/src/tools.js
@@ -0,0 +1,68 @@
+import { MAX_NAME_LENGTH } from './limits.js' // = ds-bot roster's 40-character name truncation
+// Model tools. The caller comes from the tool context ({ botId }), never from arguments,
+// so a bot can only create children under itself. Visible only to tree members.
+// tools.register keeps only type/description/enum/items from JSON Schema (minLength/maxLength
+// are dropped), so every execute() validates its own arguments with validateArgs().
+
+/** Returns null when args satisfy the schema's required/type/minLength/maxLength, else a reason. */
+export function validateArgs(schema, args) {
+  const a = args && typeof args === 'object' ? args : {}
+  for (const key of schema.required ?? []) if (a[key] === undefined || a[key] === null) return `${key} is required`
+  for (const [key, s] of Object.entries(schema.properties ?? {})) {
+    const v = a[key]
+    if (v === undefined || v === null) continue
+    if (s.type === 'string') {
+      if (typeof v !== 'string') return `${key} must be a string`
+      const n = v.trim().length
+      if (Number.isInteger(s.minLength) && n < s.minLength) return `${key} must be at least ${s.minLength} characters`
+      if (Number.isInteger(s.maxLength) && n > s.maxLength) return `${key} must be at most ${s.maxLength} characters`
+    }
+  }
+  if (schema.additionalProperties === false) {
+    const extra = Object.keys(a).filter(k => !Object.hasOwn(schema.properties ?? {}, k))
+    if (extra.length) return `unknown argument: ${extra.join(', ')}`
+  }
+  return null
+}
+
+export const LIST_CHILDREN_SCHEMA = Object.freeze({ type: 'object', properties: {}, additionalProperties: false })
+export const CREATE_CHILD_SCHEMA = Object.freeze({
+  type: 'object',
+  properties: {
+    name: { type: 'string', minLength: 1, maxLength: MAX_NAME_LENGTH, description: 'Short domain name, e.g. "Cooking"' },
+    role_description: { type: 'string', minLength: 1, maxLength: 1000, description: 'What the child is responsible for' },
+  },
+  required: ['name', 'role_description'],
+  additionalProperties: false,
+})
+
+export function registerTreeTools(fb, tree) {
+  const inTree = botId => tree.isMember(botId) // visibleTo is sync
+  const fail = e => ({ error: e instanceof Error ? e.message : String(e) })
+  return [
+    fb.registerTool({
+      name: 'list_children',
+      description: 'List your direct child bots (id, name, role). These and your parent are the only bots you can message.',
+      parameters: LIST_CHILDREN_SCHEMA,
+      visibleTo: inTree,
+      async execute(args, { botId }) {
+        const bad = validateArgs(LIST_CHILDREN_SCHEMA, args ?? {})
+        if (bad) return fail(bad)
+        const nodes = tree.snapshot()
+        if (!nodes[botId]) return fail('this bot is not part of the tree')
+        return { children: tree.childrenOf(nodes, botId).map(({ id, name, role }) => ({ id, name, role })), depth: tree.depthOf(nodes, botId), limits: tree.limits }
+      },
+    }),
+    fb.registerTool({
+      name: 'create_child_bot',
+      description: 'Create a NEW child bot directly under yourself, then delegate to it. Only when none of your children fits; never a duplicate.',
+      parameters: CREATE_CHILD_SCHEMA,
+      visibleTo: inTree,
+      async execute(args, { botId }) {
+        const bad = validateArgs(CREATE_CHILD_SCHEMA, args)
+        if (bad) return fail(bad)
+        try { return { created: await tree.createChild(botId, args.name, args.role_description) } } catch (e) { return fail(e) }
+      },
+    }),
+  ]
+}
diff --git a/plugins/tree/src/tree.js b/plugins/tree/src/tree.js
new file mode 100644
index 0000000000000000000000000000000000000000..43074d6e7bcd35f4557d4c4026948a3600e4a1a1
--- /dev/null
+++ b/plugins/tree/src/tree.js
@@ -0,0 +1,207 @@
+// Tree model over per-bot fields (all sync, namespaced to 'flybot-tree'). Fields used:
+//   parent:   parent bot id (absent/null for the root)    (the tree edge)
+//   treeRole: role description; 'root' marks the root      (marks a bot as a tree member)
+// The root is ds-bot's Main Bot (Chief, BotView.isMain), adopted with treeRole 'root'. A separate
+// root bot is created only when the team has no Main Bot at all.
+import { checkCreate } from './limits.js'
+import { systemPrompt, withTreeBlock, hasTreeBlock } from './prompt.js'
+import { forestOf } from './forest.js'
+export { forestOf }
+
+export const TREE_KEYS = new Set(['parent', 'treeRole'])
+export const ROOT_ROLE = 'root'
+const LEGACY_ROOT_ROLE = 'Top-level coordinator for everything.'
+const ROOT_LABEL = 'Main bot and root of the tree'
+
+export function createTree(fb, { limits, rootName = 'Root', rootBotId, adoptExisting = true, warn = () => {} } = {}) {
+  const listeners = new Set()
+
+  function snapshot() {
+    const nodes = {}
+    for (const b of fb.listBots()) {
+      const role = fb.getField(b.id, 'treeRole')
+      const parent = fb.getField(b.id, 'parent')
+      if (role === undefined && parent === undefined) continue
+      nodes[b.id] = { id: b.id, name: b.name, role: role === ROOT_ROLE ? ROOT_LABEL : (role ?? ''), parent: parent ?? null, root: role === ROOT_ROLE }
+    }
+    return nodes
+  }
+  const childrenOf = (nodes, id) => Object.values(nodes).filter(n => n.parent === id)
+  const depthOf = (nodes, id) => { let d = 0; for (let x = id, seen = new Set(); x && nodes[x] && !seen.has(x); x = nodes[x].parent) { seen.add(x); d++ } return d }
+  const traceOf = (nodes, id) => { const p = []; for (let x = id; x && nodes[x] && p.length < 64; x = nodes[x].parent) p.unshift(nodes[x].name); return p.join(' → ') }
+
+  const promptFor = (id, nodes = snapshot()) => {
+    const n = nodes[id]
+    return n && systemPrompt({ name: n.name, role: n.role, trace: traceOf(nodes, id), children: childrenOf(nodes, id), root: n.root })
+  }
+  // Prompt injection: only the tree's marked block is replaced; other text (e.g. Chief's own) stays.
+  const writeBlock = (id, block) => {
+    const current = fb.getSystemPrompt(id)
+    const next = withTreeBlock(current, block)
+    if (next !== String(current ?? '').trim()) fb.setSystemPrompt(id, next)
+  }
+  const refreshPrompt = (id, nodes = snapshot()) => { if (nodes[id]) writeBlock(id, promptFor(id, nodes)) }
+
+  // ---------------------------------------------------------------- root
+  /** The Main Bot (Chief): config.rootBotId if it exists, else the Main Bot named 'Chief', else the first Main Bot. */
+  function findChief() {
+    const bots = fb.listBots()
+    if (rootBotId) return bots.find(b => b.id === rootBotId)
+    const mains = bots.filter(b => b.isMain === true)
+    return mains.find(b => b.name === 'Chief') ?? mains[0]
+  }
+  const isLegacyRoot = (b, chiefId) => b.id !== chiefId && b.isMain !== true && fb.getField(b.id, 'parent') == null &&
+    fb.getField(b.id, 'treeRole') !== undefined && (b.name === rootName || fb.getField(b.id, 'treeRole') === LEGACY_ROOT_ROLE)
+
+  /** Earlier installs auto-created a separate 'Root': move its children to Chief, clear its tree fields and block. Never deletes it. Idempotent. */
+  function migrateLegacyRoots(chiefId) {
+    const moved = []
+    for (const b of fb.listBots()) {
+      if (!isLegacyRoot(b, chiefId)) continue
+      for (const c of fb.listBots()) if (fb.getField(c.id, 'parent') === b.id) { fb.setField(c.id, 'parent', chiefId); moved.push(c.id) }
+      fb.setField(b.id, 'parent', null)
+      fb.setField(b.id, 'treeRole', null)
+      fb.setField(b.id, 'retired', true) // out of the tree for good; adoption skips it
+      const prompt = fb.getSystemPrompt(b.id)
+      if (hasTreeBlock(prompt)) writeBlock(b.id, '')
+      else if (/a bot in a recursive bot tree/.test(prompt)) fb.setSystemPrompt(b.id, '') // pre-block installs: the whole prompt was ours
+    }
+    return moved
+  }
+
+  /** Adopts Chief as the root (treeRole 'root', no bot created). Returns its id, or undefined while the team is not loaded. */
+  function adoptChief() {
+    const chief = findChief()
+    if (!chief) return undefined
+    if (fb.getField(chief.id, 'parent') !== undefined) fb.setField(chief.id, 'parent', null)
+    if (fb.getField(chief.id, 'treeRole') !== ROOT_ROLE) fb.setField(chief.id, 'treeRole', ROOT_ROLE)
+    migrateLegacyRoots(chief.id)
+    if (adoptExisting) adoptUnattached(chief.id)
+    const nodes = snapshot()
+    for (const id of [chief.id, ...childrenOf(nodes, chief.id).map(c => c.id)]) refreshPrompt(id, nodes)
+    return chief.id
+  }
+
+  /**
+   * Every local bot with no tree fields (and not retired) becomes a child of the root, up to
+   * maxChildren; the rest stay unattached with a warning. Remote bots are never in bot.list().
+   */
+  function adoptUnattached(rootId) {
+    const adopted = [], skipped = []
+    for (const b of fb.listBots()) {
+      if (b.id === rootId || fb.isRemote?.(b.id)) continue
+      if (fb.getField(b.id, 'retired') === true) continue
+      if (fb.getField(b.id, 'parent') !== undefined || fb.getField(b.id, 'treeRole') !== undefined) continue
+      if (b.isMain === true && !rootBotId) continue // another Main Bot stays outside the tree
+      if (childrenOf(snapshot(), rootId).length >= limits.maxChildren) { skipped.push(b.name); continue }
+      fb.setField(b.id, 'treeRole', String(b.role ?? '').trim())
+      fb.setField(b.id, 'parent', rootId)
+      adopted.push(b.id)
+    }
+    if (skipped.length) warn(`flybot-tree: ${skipped.length} bot(s) left outside the tree because the root already has maxChildren=${limits.maxChildren} children: ${skipped.join(', ')}`)
+    if (adopted.length) { const nodes = snapshot(); for (const id of adopted) refreshPrompt(id, nodes) }
+    return { adopted, skipped }
+  }
+
+  /**
+   * Synchronous nested view for UIs: [{ id, name, role, root, createdAt, children }], roots first,
+   * siblings ordered by createdAt (then name). Bots whose parent is missing are listed at the top level.
+   */
+  function forest() { return forestOf(fb.listBots().map(b => ({ ...b, fields: { 'flybot-tree': { parent: fb.getField(b.id, 'parent'), treeRole: fb.getField(b.id, 'treeRole'), retired: fb.getField(b.id, 'retired') } } }))) }
+
+  let rootTask
+  /**
+   * Idempotent; concurrent calls share one creation. Adopts Chief; creates a root bot only when the
+   * team has bots but no Main Bot. With no bots listed yet (team not loaded) it resolves undefined.
+   */
+  function ensureRoot({ create = true } = {}) {
+    const adopted = adoptChief()
+    if (adopted) return Promise.resolve(adopted)
+    if (rootBotId) return Promise.resolve(undefined) // configured root not there (yet)
+    const existing = Object.values(snapshot()).find(n => n.root || n.parent === null)
+    if (existing) return Promise.resolve(existing.id)
+    if (!create || fb.listBots().length === 0) return Promise.resolve(undefined)
+    rootTask ??= createRoot().finally(() => { rootTask = undefined })
+    return rootTask
+  }
+  async function createRoot() {
+    const prompt = systemPrompt({ name: rootName, role: ROOT_LABEL, trace: rootName, children: [], root: true })
+    return fb.createBot({ name: rootName, systemPrompt: withTreeBlock('', prompt), fields: { parent: null, treeRole: ROOT_ROLE } })
+  }
+
+  // createChild checks limits, then awaits createBot: serialize per parent so parallel calls
+  // see each other's children (no maxChildren overflow, no duplicate-name siblings).
+  const createLocks = new Map()
+  function withParentLock(parentId, fn) {
+    const prev = createLocks.get(parentId) ?? Promise.resolve()
+    const run = prev.then(fn, fn)
+    const tail = run.then(() => {}, () => {})
+    createLocks.set(parentId, tail)
+    tail.then(() => { if (createLocks.get(parentId) === tail) createLocks.delete(parentId) })
+    return run
+  }
+
+  /** Creates a child under parentId (the CALLER; the tool never takes a parent argument). */
+  function createChild(parentId, name, roleDescription) {
+    return withParentLock(parentId, () => createChildNow(parentId, name, roleDescription))
+  }
+  async function createChildNow(parentId, name, roleDescription) {
+    const nodes = snapshot()
+    const parent = nodes[parentId]
+    if (!parent) throw new Error('this bot is not part of the tree')
+    const clean = String(name ?? '').trim()
+    const role = String(roleDescription ?? '').trim()
+    const reason = checkCreate({ parentName: parent.name, parentDepth: depthOf(nodes, parentId), siblings: childrenOf(nodes, parentId), name: clean, limits })
+    if (reason) throw new Error(reason)
+    const prompt = systemPrompt({ name: clean, role, trace: `${traceOf(nodes, parentId)} → ${clean}`, children: [] })
+    const id = await fb.createBot({ name: clean, systemPrompt: withTreeBlock('', prompt), fields: { parent: parentId, treeRole: role } })
+    refreshPrompt(parentId) // the parent now lists the new child
+    return { id, name: clean, depth: depthOf(nodes, parentId) + 1 }
+  }
+
+  // A tree member has treeRole (or parent; the root's parent is null/absent).
+  const isMember = id => typeof id === 'string' && (fb.getField(id, 'treeRole') !== undefined || fb.getField(id, 'parent') !== undefined)
+  const parentOf = id => fb.getField(id, 'parent') ?? null
+  const isRoot = id => isMember(id) && (fb.getField(id, 'treeRole') === ROOT_ROLE || fb.getField(id, 'parent') == null)
+  function isTreeEdge(from, to) {
+    const fromIn = isMember(from), toIn = isMember(to)
+    return { fromIn, toIn, inTree: fromIn && toIn, allowed: fromIn && toIn && (parentOf(to) === from || parentOf(from) === to) }
+  }
+
+  const emit = change => { for (const fn of listeners) fn(change) }
+  function onFieldChange(change) {
+    if (!change || !TREE_KEYS.has(change.key)) return
+    emit(change)
+  }
+  /**
+   * After deletion: the removed bot's children re-attach to its parent (from the event's last record).
+   * Every reparented child and its descendants get a fresh prompt (their trace no longer names the
+   * deleted bot). maxChildren is NOT enforced here: deleting a bot never orphans or drops its
+   * children; if the new parent ends up over the limit we only warn, and create_child_bot keeps
+   * refusing new children there until it is back under the limit.
+   */
+  function onBotRemoved({ botId, parent }) {
+    if (parent === undefined) return // not a tree bot
+    const up = parent ?? null
+    const moved = childrenOf(snapshot(), botId)
+    for (const child of moved) fb.setField(child.id, 'parent', up)
+    const nodes = snapshot()
+    if (up && nodes[up]) {
+      refreshPrompt(up, nodes)
+      const count = childrenOf(nodes, up).length
+      if (count > limits.maxChildren) warn(`flybot-tree: ${nodes[up].name} now has ${count} children after a deletion (maxChildren=${limits.maxChildren}); kept all, new children are refused until it is under the limit`)
+    }
+    const stack = moved.map(c => c.id), seen = new Set()
+    while (stack.length) {
+      const id = stack.pop()
+      if (seen.has(id)) continue
+      seen.add(id)
+      refreshPrompt(id, nodes)
+      for (const c of childrenOf(nodes, id)) stack.push(c.id)
+    }
+    emit({ botId, key: 'removed' })
+  }
+  const subscribe = fn => { listeners.add(fn); return () => listeners.delete(fn) }
+
+  return { limits, forest, adoptUnattached, snapshot, childrenOf, depthOf, traceOf, ensureRoot, adoptChief, findChief, migrateLegacyRoots, promptFor, createChild, isMember, isRoot, isTreeEdge, onFieldChange, onBotRemoved, subscribe }
+}
diff --git a/plugins/tree/test/mock-flybot.js b/plugins/tree/test/mock-flybot.js
new file mode 100644
index 0000000000000000000000000000000000000000..a93d933ff980932a365dfb4b69d1132c15117451
--- /dev/null
+++ b/plugins/tree/test/mock-flybot.js
@@ -0,0 +1,120 @@
+// In-memory mock of ctx.flybot matching ds-bot types/flybot.d.ts (API v1) / src/host/hooks.js:
+// - flybot.scope(plugin) returns the same API with fields/events namespaced to `plugin`;
+//   the unscoped service is plugin 'shared'.
+// - fields are sync, stored as bot.fields[plugin][key]; null/undefined removes the key.
+// - on('change'|'bot.created'|'bot.removed', fn, { all? }); 'change' is own-plugin unless all.
+// - bot.create(spec) is async and resolves to the new id; systemPrompt is on the Bot record.
+// - bot.isRemote(ref): { kind: 'remote' } or '@handle'; local ids never.
+// - send targets: { remote: false, id } | { remote: true, handle, home }.
+// - tools.register drops JSON Schema keywords other than type/description/enum/items.
+const clone = v => (v === undefined ? undefined : structuredClone(v))
+const isRemote = ref => (ref !== null && typeof ref === 'object' && ref.kind === 'remote') || (typeof ref === 'string' && ref.startsWith('@'))
+const toRemote = ref => (typeof ref === 'string' ? { kind: 'remote', handle: ref, home: '@' + ref.split('.').slice(1).join('.') } : ref)
+const targetOf = ref => (isRemote(ref) ? { remote: true, handle: toRemote(ref).handle, home: toRemote(ref).home } : { remote: false, id: ref })
+const keep = ({ type, description, enum: values, items }) => ({ type, ...(description ? { description } : {}), ...(values ? { enum: values } : {}), ...(items ? { items: keep(items) } : {}) })
+export function toParameterMap(p) {
+  if (p?.type !== 'object' || typeof p.properties !== 'object') return p ?? {}
+  const req = new Set(p.required ?? [])
+  return Object.fromEntries(Object.entries(p.properties).map(([k, s]) => [k, { ...keep(s), ...(req.has(k) ? { required: true } : {}) }]))
+}
+
+export function createMockFlybot() {
+  const bots = new Map() // id -> { id, name, systemPrompt, fields: { [plugin]: {...} } }
+  const listeners = { 'change': new Set(), 'bot.created': new Set(), 'bot.removed': new Set() }
+  const middlewares = []
+  const tools = new Map()
+  const scopes = []
+  let seq = 0
+  const view = b => b && { id: b.id, name: b.name, isMain: b.isMain === true, createdAt: b.createdAt, createdBy: null, systemPrompt: b.systemPrompt ?? '', fields: clone(b.fields) }
+  const fire = (ev, payload) => { for (const fn of [...listeners[ev]]) fn({ ...payload }) }
+  const onFor = plugin => (ev, fn, { all = false } = {}) => {
+    if (!listeners[ev]) throw new Error(`flybot: unknown event ${ev}`)
+    const l = ev === 'change' && !all ? c => { if (c.plugin === plugin) fn(c) } : fn
+    listeners[ev].add(l); return () => listeners[ev].delete(l)
+  }
+  const fieldsFor = plugin => ({
+    get: (id, k) => clone(bots.get(id)?.fields?.[plugin]?.[k]),
+    all: id => clone(bots.get(id)?.fields?.[plugin] ?? {}),
+    set: (id, k, v) => {
+      const b = bots.get(id); if (!b) throw new Error('flybot: unknown Bot ' + id)
+      const prev = clone(b.fields[plugin]?.[k]); const next = v === null ? undefined : clone(v)
+      if (JSON.stringify(prev) === JSON.stringify(next)) return
+      b.fields[plugin] ??= {}
+      if (next === undefined) delete b.fields[plugin][k]; else b.fields[plugin][k] = next
+      if (!Object.keys(b.fields[plugin]).length) delete b.fields[plugin]
+      fire('change', { botId: id, plugin, key: k, value: next, prev })
+    },
+    query: (k, v) => [...bots.values()].filter(b => b.fields[plugin] && Object.hasOwn(b.fields[plugin], k) && (v === undefined || JSON.stringify(b.fields[plugin][k]) === JSON.stringify(v))).map(view),
+    on: onFor(plugin),
+  })
+  const order = () => {
+    const out = middlewares.filter(m => m.name !== 'social')
+    const social = middlewares.find(m => m.name === 'social')
+    if (social) { const i = out.findIndex(m => !(m.before ?? []).includes('social')); out.splice(i < 0 ? out.length : i, 0, social) }
+    return out
+  }
+  const remote = new Set() // test hook only: local ids the real host would never call remote
+  const send = async (req, { bypassEnabled = false } = {}) => {
+    const msg = { role: 'request', hop: 0, via: 'shared', exchangeId: `x${++seq}`, ...req, to: isRemote(req.to) ? toRemote(req.to) : req.to, target: req.target ?? targetOf(req.to) }
+    let skip = new Set()
+    for (const m of order()) {
+      if (skip.has(m.name)) continue
+      const r = await m.handle(msg)
+      if (r === undefined || r === null) continue
+      if (r.action === 'allow' && r.bypass && bypassEnabled) { skip = new Set(r.bypass); continue }
+      if (r.action === 'allow') continue
+      return { ...r, by: m.name }
+    }
+    return { action: 'allow', exchangeId: msg.exchangeId }
+  }
+  const build = plugin => {
+    scopes.push(plugin)
+    const fields = fieldsFor(plugin)
+    return {
+      version: 1,
+      plugin,
+      scope: build,
+      on: onFor(plugin),
+      fields,
+      bot: {
+        get: id => view(bots.get(id)),
+        list: () => [...bots.values()].map(view),
+        find: name => view([...bots.values()].find(b => b.name === name)),
+        isRemote: ref => isRemote(ref) || remote.has(ref),
+        create: async ({ name, systemPrompt, fields: f } = {}) => {
+          await Promise.resolve() // really async, like the host
+          const id = `bot${++seq}`
+          bots.set(id, { id, name, createdAt: seq, systemPrompt: systemPrompt ?? '', fields: f && Object.keys(f).length ? { [plugin]: clone(f) } : {} })
+          for (const [key, value] of Object.entries(f ?? {})) fire('change', { botId: id, plugin, key, value: clone(value), prev: undefined })
+          fire('bot.created', view(bots.get(id)))
+          return id
+        },
+        setSystemPrompt: (id, text) => { const b = bots.get(id); if (!b) throw new Error('flybot: unknown Bot ' + id); b.systemPrompt = String(text ?? '').trim() },
+        fields,
+        send: Object.assign((req, opts) => send({ via: plugin, ...req }, opts), {
+          use: m => { if (middlewares.some(x => x.name === m.name)) throw new Error('exists'); middlewares.push(m); return () => { const i = middlewares.indexOf(m); if (i >= 0) middlewares.splice(i, 1) } },
+          list: () => middlewares.map(m => ({ name: m.name, before: m.before ?? [], after: m.after ?? [] })),
+        }),
+      },
+      tools: { register: t => { const spec = { ...t, parameters: toParameterMap(t.parameters) }; tools.set(t.name, spec); return () => tools.delete(t.name) } },
+    }
+  }
+  const flybot = build('shared')
+  // Test helpers (not part of the real API).
+  // Like ds-bot's setup: the first Bot, 'Chief', is a Main Bot (state.mainBotIds). Fires bot.created.
+  const addBot = ({ name, isMain = false, systemPrompt = '', fields: f = {} } = {}) => {
+    const id = `bot${++seq}`
+    bots.set(id, { id, name, isMain, createdAt: seq, systemPrompt, fields: clone(f) })
+    fire('bot.created', view(bots.get(id)))
+    return id
+  }
+  const removeBot = id => { const last = view(bots.get(id)); bots.delete(id); fire('bot.removed', { ...last, botId: id, bot: last }) }
+  const call = async (botId, name, args = {}) => {
+    const t = tools.get(name)
+    const visible = t?.visibleTo(botId)
+    if (visible instanceof Promise) throw new Error('visibleTo must be sync')
+    if (!t || !visible) throw new Error(`tool ${name} not visible to ${botId}`)
+    return t.execute(args, { botId })
+  }
+  return { flybot, bots, tools, middlewares, scopes, remote, removeBot, addBot, call }
+}
