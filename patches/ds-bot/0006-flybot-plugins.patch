+    // without social.createInvite it uses flybot.call('social.createInvite', { botId })
+    const via = []
+    const r = await mod.copyInvite({ social: { canInvite: () => true }, call: async (name, payload) => { via.push([name, payload]); return { text: 'T', link: 'L' } } }, 'b3')
