+  installMemberAuth(rt)
+  installAuthz(rt)
+  installRooms(rt)
+  installReach(rt)
+  t.after(async () => {
+    await Promise.all(disposers.splice(0).map(cleanup => cleanup()))
+    rmSync(dir, { recursive: true, force: true, maxRetries: 5 })
+  })
+  return { rt, statePath }
