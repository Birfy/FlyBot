+  }
+
+  rt.publicHumans = function publicHumans() {
+    return Object.values(state.members || {}).map(member => ({
+      id: member.id,
+      designatedChiefId: member.designatedChiefId ?? null,
+      displayName: displayNameFor(state, member.id),
