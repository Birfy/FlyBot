+    const localAuthor = line.authorKind === 'bot' && !line.remote && rt.botOf?.(line.authorId ?? line.botId) ? (line.authorId ?? line.botId) : undefined
+    if (localAuthor !== undefined && !mayShareRoom(state, room, localAuthor)) return
