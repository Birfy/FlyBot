+// FlyBot remote chats: a friend's (remote) Bot as a chat of its own, in ds-bot's own
+// session model. Each remote Bot a plugin publishes gets a Bot record marked `remote`
+// ({ handle, home, homeName, plugin }) whose Session runs on the model route
+// `flybot-remote/<handle>`. That route is an LLM adapter registered here which calls no
+// model: a message the user types in the chat goes to the plugin's sender (the transport
+// to the friend's Bot), and a message from the friend's Bot, posted into the chat as a
+// hidden relay, is written back as the assistant's reply. So history, unread marks, the
+// last-message preview and the sidebar row all work as for a local Bot.
+//
+// Remote chat Bots are not team members: findBot, the team tools, flybot.bot.list() and
+// memory skip them, and the tree never adopts them.
+import { randomUUID } from 'node:crypto'
+import { createUserMessage, LlmAdapter } from '@deepseek-ai/dsh-llm'
+import { SOURCE_KIND } from './constants.js'
+import { cleanName, fenceUntrusted } from './delivery.js'
+
+export const REMOTE_PROVIDER = 'flybot-remote'
+export const REMOTE_FORM = 'remote-chat'
+const SENT_KEPT = 500
+
+export const isRemoteChat = bot => typeof bot?.remote?.handle === 'string'
+const textOf = content => (Array.isArray(content) ? content.filter(block => block?.type === 'text').map(block => block.text).join('\n') : String(content ?? ''))
+
+/**
+ * What a model call on a remote chat's route should do, from the request alone:
+ * { kind: 'echo', text } writes a friend's message back as the reply; { kind: 'send',
+ * messageId, text } is a message the user typed in the chat; { kind: 'none' } is anything
+ * else (a kickoff, a one-off request without a durable message), which writes nothing.
+ */
+// Messages the host appends as role:'user' that the user did not type: context snapshots (the
+// time context), the AGENTS.md baseline (form 'instructions') and notices (plan mode, tool
+// reminders). Matched by form, not by a whitelist of senders, so a new notice kind is skipped too.
+const CONTEXT_FORMS = new Set(['snapshot', 'instructions', 'notice'])
+const isContextSnapshot = source => CONTEXT_FORMS.has(source?.form) || source?.kind === 'agent-instructions' || source?.kind === 'ds-bot-time-context' || source?.kind === 'time-context'
+
+export function remoteTurn(messages) {
+  // Context the host appends as user messages (the time context, refreshed every few minutes;
+  // the AGENTS.md baseline on a chat's first turn; notices) is not what the user typed: skip it,
+  // or the turn reads as 'none' and the user's message is silently dropped (#66).
+  const last = [...(messages ?? [])].reverse().find(message => message?.role === 'user' && !isContextSnapshot(message.source))
+  if (last === undefined || typeof last.id !== 'string') return { kind: 'none' }
+  const source = last.source
+  if (source?.form === REMOTE_FORM && typeof source.text === 'string') return { kind: 'echo', text: source.text, messageId: last.id }
+  if (source === undefined || source === null || source.kind === 'user') {
+    const text = textOf(last.content).trim()
+    return text ? { kind: 'send', text, messageId: last.id } : { kind: 'none' }
+  }
+  return { kind: 'none' }
+}
+
+export function install(rt) {
+  const { ctx, state } = rt
+  const warn = (...args) => rt.warn?.(...args)
+  const chats = () => Object.values(state.bots ?? {}).filter(isRemoteChat)
+  const chatOfHandle = handle => chats().find(bot => bot.remote.handle === handle)
+  const senders = new Map()
+  const pending = new Map()
+
+  async function* streamText(text) {
+    if (text) {
+      yield { type: 'block-start', index: 0, blockType: 'text' }
+      yield { type: 'text-delta', index: 0, text }
+      yield { type: 'block-end', index: 0, block: { type: 'text', text } }
+    }
+    yield { type: 'usage', usage: { inputTokens: 0, outputTokens: 0 } }
+    yield { type: 'finish', reason: { kind: 'stop' } }
+  }
+
+  const sentStore = () => {
+    state.flybot ??= {}
+    state.flybot.remoteSent ??= []
+    return state.flybot.remoteSent
+  }
+  async function forward(handle, turn) {
+    const bot = chatOfHandle(handle)
+    if (bot === undefined) return `Not sent: ${handle} is not a friend's Bot any more.`
+    const sent = sentStore()
+    // A retried turn never sends the same message twice.
+    if (sent.includes(turn.messageId)) return ''
+    const sender = senders.get(bot.remote.plugin)
+    if (sender === undefined) return 'Not sent: the plugin that reaches this Bot is not running.'
+    try {
+      await sender({ handle, text: turn.text, botId: bot.id, remote: { ...bot.remote } })
+      sent.push(turn.messageId)
+      if (sent.length > SENT_KEPT) sent.splice(0, sent.length - SENT_KEPT)
+      void rt.save().catch(() => {})
+      return ''
+    } catch (error) {
+      return `Not sent: ${error?.message ?? error}`
+    }
+  }
+
+  class RemoteAdapter extends LlmAdapter {
+    providerInfo(provider) { return { id: provider, name: 'Friends\' Bots' } }
+    async listModels(provider) {
+      const handles = new Set([...chats().map(bot => bot.remote.handle), ...pending.keys()])
+      return [...handles].map(handle => ({ provider, id: handle, name: chatOfHandle(handle)?.name ?? pending.get(handle) ?? handle, inputModalities: ['text'] }))
+    }
+    async resolveModel(provider, model) {
+      return { provider, id: model, name: chatOfHandle(model)?.name ?? model, inputModalities: ['text'], context: { contextWindow: 1_000_000 }, defaultMaxTokens: 4096 }
+    }
+    async *stream(options) {
+      const turn = remoteTurn(options.messages)
+      if (turn.kind === 'echo') yield* streamText(turn.text)
+      else if (turn.kind === 'send') yield* streamText(await forward(options.model, turn))
+      else yield* streamText('')
+    }
+  }
+  try {
+    const off = ctx.llm?.registerAdapter?.([REMOTE_PROVIDER], new RemoteAdapter())
+    if (typeof off === 'function') ctx.effect?.(() => off, 'ds-bot: remote chat route')
+  } catch (error) {
+    warn('ds-bot: remote chats are off: %s', error)
+  }
+
+  let opening = Promise.resolve()
+  // Creates the chat for a remote Bot (once), or refreshes its name and home label.
+  function open({ handle, name, home, homeName, plugin }) {
+    const run = opening.then(async () => {
+      await rt.load()
+      const existing = chatOfHandle(handle)
+      if (existing !== undefined) {
+        const next = { ...existing.remote, home, ...(homeName ? { homeName } : {}), plugin, gone: undefined }
+        delete next.gone
+        if (JSON.stringify(next) !== JSON.stringify(existing.remote) || (name && existing.name !== name)) {
+          existing.remote = next
+          if (name) existing.name = String(name).slice(0, 40)
+          await rt.save()
+        }
+        return existing.id
+      }
+      pending.set(handle, name)
+      try {
+        const bot = await rt.createBot({ name: String(name || handle).slice(0, 40), model: `${REMOTE_PROVIDER}/${handle}`, remote: { handle, home, ...(homeName ? { homeName } : {}), plugin } })
+        return bot.id
+      } finally { pending.delete(handle) }
+    })
+    opening = run.catch(() => {})
+    return run
+  }
+
+  // A published list: every Bot gets its chat; a chat whose Bot left keeps its history, marked gone.
+  async function sync(plugin, list) {
+    const handles = new Set()
+    for (const member of list) {
+      handles.add(member.handle)
+      await open({ ...member, plugin }).catch(error => warn('ds-bot: chat for %s not opened: %s', member.handle, error))
+    }
+    let changed = false
+    for (const bot of chats()) {
+      if (bot.remote.plugin !== plugin) continue
+      const gone = !handles.has(bot.remote.handle)
+      if (Boolean(bot.remote.gone) !== gone) { bot.remote = { ...bot.remote, ...(gone ? { gone: true } : {}) }; if (!gone) delete bot.remote.gone; changed = true }
+    }
+    if (changed) await rt.save()
+  }
+
+  // A message from the friend's Bot, into its chat: a hidden relay (fenced, as any text
+  // from outside the team) that the chat's route writes back as the reply.
+  async function deliver({ handle, text, name, home, plugin }) {
+    const id = chatOfHandle(handle)?.id ?? await open({ handle, name: name ?? handle, home, plugin })
+    const bot = rt.botOf(id)
+    const agent = await rt.resolveAgent(rt.chatOf(id))
+    const shownName = cleanName(bot?.name ?? name ?? handle)
+    agent.followup(createUserMessage({
+      content: [{ type: 'text', text: `[Message from ${shownName} (${cleanName(handle)})]\n${fenceUntrusted(shownName, text)}` }],
+      source: { kind: SOURCE_KIND, form: REMOTE_FORM, role: 'remote', exchangeId: randomUUID(), senderName: shownName, hop: 0, remote: { handle, ...(home ? { home } : {}) }, text: String(text) },
+    }))
+    await ctx.sessions.flush(agent.session)
+    await rt.ingestRemoteRoomLine?.({ handle, text, name: shownName }).catch(error => warn('ds-bot: room ingest for %s failed: %s', handle, error))
+    return id
+  }
+
+  const onSend = (plugin, fn) => {
+    senders.set(plugin, fn)
+    return () => { if (senders.get(plugin) === fn) senders.delete(plugin) }
+  }
+
+  Object.assign(rt, { remoteChats: { open, sync, deliver, onSend, list: () => chats().map(bot => ({ id: bot.id, ...bot.remote, name: bot.name })), of: handle => chatOfHandle(handle)?.id } })
+}
diff --git a/test/inbound-ui.test.js b/test/inbound-ui.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..39d54cd523c8ec081a66c0a95393f62869d890cc
--- /dev/null
+++ b/test/inbound-ui.test.js
@@ -0,0 +1,83 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { fileURLToPath } from 'node:url'
+import { runInNewContext } from 'node:vm'
+import { build } from 'esbuild'
+
+// The inbound friend conversation's display: trace lines, the thinking row, the remote speaker.
+const { outputFiles } = await build({
+  stdin: {
+    contents: "export { stripTrace, previewOf, nameMentions } from './src/client/text.js'\nexport { remoteSpeaker } from './src/client/cells.js'",
+    resolveDir: fileURLToPath(new URL('..', import.meta.url)),
+  },
+  bundle: true, format: 'cjs', platform: 'browser', write: false, logLevel: 'silent',
+  external: ['react', 'react-dom', '@deepseek-ai/dsh-client-ui-primitives'],
+})
+const h = (type, props, ...children) => ({ type, props: { ...props, children } })
+const react = { createElement: h, Fragment: Symbol('F'), useEffect() {}, useLayoutEffect() {}, useState: v => [v, () => {}], useMemo: f => f(), useRef: current => ({ current }) }
+const module = { exports: {} }
+runInNewContext(outputFiles[0].text, {
+  module, exports: module.exports, document: { hidden: false }, navigator: { language: 'en' }, localStorage: { getItem: () => null, setItem() {} },
+  require: (name) => {
+    if (name === 'react') return react
+    if (name === 'react-dom') return { createPortal: node => node }
+    if (name === '@deepseek-ai/dsh-client-ui-primitives') return { MarkdownText: ({ text }) => text }
+    throw new Error(`Unexpected platform module ${name}`)
+  },
+})
+const { stripTrace, previewOf, nameMentions, remoteSpeaker } = module.exports
+
+test('a reply opening with a delegation trace shows without it', () => {
+  assert.equal(stripTrace('Chief → 助手\n\nHi Chief! Good to hear from you.'), 'Hi Chief! Good to hear from you.')
+  assert.equal(stripTrace('user → 助手\nHi!'), 'Hi!')
+  assert.equal(stripTrace('Chief → 程序员 → 后端\n\nDone.'), 'Done.')
+  assert.equal(stripTrace('Use Settings → Models first'), 'Use Settings → Models first')
+})
+
+test('ordinary text that merely mentions an arrow is left alone', () => {
+  for (const text of ['Hi! Step one → step two.', 'Settings → Models, then retry', 'Plain reply', 'a → b: see below\nmore']) {
+    assert.equal(stripTrace(text), text)
+  }
+  assert.equal(stripTrace(undefined), undefined)
+})
+
+test('the sidebar preview drops the trace too', () => {
+  const list = { byId: { s: { projectionValues: { turnOutline: [{ turn: 2, prompt: '', response: 'Chief → 助手\n\nHi Chief!' }] } } } }
+  assert.equal(previewOf(list, 's'), 'Hi Chief!')
+  const flat = { byId: { s: { projectionValues: { turnOutline: [{ turn: 1, prompt: '', response: 'Chief → 助手 Hi! Message received.' }] } } } }
+  assert.equal(previewOf(flat, 's'), 'Hi! Message received.')
+  const plain = { byId: { s: { projectionValues: { turnOutline: [{ turn: 1, prompt: '', response: 'Use Settings → Models first' }] } } } }
+  assert.equal(previewOf(plain, 's'), 'Use Settings → Models first')
+})
+
+test("an inbound friend's message uses the friend's sidebar Bot (avatar, name), else a stable look from its handle", () => {
+  const chat = { id: 'session-x', name: 'Chief', color: 'orange', shape: 'star', remote: { handle: '@chief.danyang.home' } }
+  const roster = { bots: [chat], remoteBots: [{ handle: '@chief.danyang.home', name: 'Chief' }] }
+  const got = remoteSpeaker({ remote: { handle: '@chief.danyang.home' } }, roster)
+  assert.equal(got.bot, chat)
+  assert.equal(got.name, "danyang's Chief")
+  assert.equal(got.chatId, 'session-x')
+  const other = remoteSpeaker({ remote: { handle: '@x.home' }, senderName: 'X' }, { bots: [], remoteBots: [] })
+  assert.equal(other.name, "X · x's Bot")
+  assert.notEqual(other.bot.color, 'gray')
+  assert.equal(other.chatId, undefined)
+})
+
+test("a friend Bot's handle in a preview reads as its display name (#71)", () => {
+  const roster = { bots: [{ id: 'f', name: '代码审查官', remote: { handle: '@bot-2a758c0f.danyang.home' } }], remoteBots: [{ handle: '@bot-2a758c0f.danyang.home', name: '代码审查官' }] }
+  assert.equal(nameMentions('@bot-2a758c0f.danyang.home 你是?', roster), '@代码审查官 你是?')
+  assert.equal(nameMentions('看 @bot-2a758c0f.danyang.home。', roster), '看 @代码审查官。')
+  // An address before the @, or a longer word after the handle, stays as written.
+  assert.equal(nameMentions('mail a@bot-2a758c0f.danyang.home', roster), 'mail a@bot-2a758c0f.danyang.home')
+  assert.equal(nameMentions('@bot-2a758c0f.danyang.home2 不在', roster), '@bot-2a758c0f.danyang.home2 不在')
+  // Unknown handles, missing rosters, and non-string input pass through.
+  assert.equal(nameMentions('@bot-x.home 你在?', roster), '@bot-x.home 你在?')
+  assert.equal(nameMentions('@bot-2a758c0f.danyang.home', undefined), '@bot-2a758c0f.danyang.home')
+  assert.equal(nameMentions(undefined, roster), '')
+  // One pass: a name that itself contains another handle is not rescanned.
+  const nested = { bots: [], remoteBots: [
+    { handle: '@b.x.home', name: '请找 @a.x.home 的主人' },
+    { handle: '@a.x.home', name: '代码审查官' },
+  ] }
+  assert.equal(nameMentions('@b.x.home 你在?', nested), '@请找 @a.x.home 的主人 你在?')
+})
diff --git a/test/remote-chat.test.js b/test/remote-chat.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..e96ef4d40dc3fa19344755d83db4d59b85144e0c
--- /dev/null
+++ b/test/remote-chat.test.js
@@ -0,0 +1,54 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { remoteTurn, isRemoteChat, REMOTE_PROVIDER } from '../src/host/remote-chat.js';
+
+const user = (content, source, id = 'm1') => ({ role: 'user', id, content, ...(source ? { source } : {}) });
+
+test('typed user text is sent to the remote bot', () => {
+    const t = remoteTurn([user('hi there')]);
+    assert.equal(t.kind, 'send');
+});
+
+test('relayed remote text is echoed, not re-sent', () => {
+    const t = remoteTurn([user('<fenced/>', { kind: 'bot', form: 'remote-chat', text: 'pong' })]);
+    assert.equal(t.kind, 'echo');
+    assert.equal(t.text, 'pong');
+});
+
+test('other sources and empty history do nothing', () => {
+    assert.equal(remoteTurn([user('x', { kind: 'bot', form: 'other' })]).kind, 'none');
+    assert.equal(remoteTurn([]).kind, 'none');
+});
+
+test('remote chats are recognised by their remote field', () => {
+    assert.equal(isRemoteChat({ remote: { handle: '@a.b.home' } }), true);
+    assert.equal(isRemoteChat({ name: 'x' }), false);
+    assert.equal(REMOTE_PROVIDER, 'flybot-remote');
+});
+
+test('roster and model guards keep a friend\'s Bot on its relay route', async () => {
+    const { readFileSync } = await import('node:fs')
+    const src = f => readFileSync(new URL('../src/host/' + f, import.meta.url), 'utf8')
+    assert.match(src('models.js'), /bot\.remote\?\.handle\) return `flybot-remote\//)
+    assert.match(src('roster.js'), /bot\.remote !== undefined\) \{ delete patch\.model/)
+})
+
+test('a time-context snapshot appended after the typed text does not swallow it', () => {
+    const clock = user('Current time: 2026-10-14, 19:47:33 GMT+08:00 (Asia/Shanghai).', { kind: 'ds-bot-time-context', form: 'snapshot', sections: [] }, 'm2');
+    const t = remoteTurn([user('hi', { kind: 'user' }), clock]);
+    assert.equal(t.kind, 'send');
+    assert.equal(t.text, 'hi');
+    assert.equal(t.messageId, 'm1');
+});
+
+test('agent-instructions and notice messages after the typed text do not swallow it', () => {
+    const baseline = user([{ type: 'text', text: '<system-reminder>AGENTS.md ...</system-reminder>' }],
+        { kind: 'agent-instructions', form: 'instructions', baseline: true, changes: [] }, 'm2');
+    const notice = user('plan mode on', { kind: 'plan-mode', form: 'notice' }, 'm3');
+    for (const extra of [[baseline], [baseline, notice]]) {
+        const t = remoteTurn([user('hi', { kind: 'user' }), ...extra]);
+        assert.equal(t.kind, 'send'); assert.equal(t.text, 'hi'); assert.equal(t.messageId, 'm1');
+    }
+    assert.equal(remoteTurn([user('<f/>', { kind: 'bot', form: 'remote-chat', text: 'pong' }), baseline]).kind, 'echo');
+    assert.equal(remoteTurn([baseline]).kind, 'none');
+});
